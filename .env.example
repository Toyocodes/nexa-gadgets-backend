# Server
PORT=5000
NODE_ENV=development            # set to "production" when deployed (enables secure, cross-site cookies)
CLIENT_URL=http://localhost:5173 # frontend origin, used in password-reset links

# Database
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<db>

# Auth — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Email (Gmail SMTP with an App Password)
EMAIL_USER=
EMAIL_PASS=

# Cloudinary (product images)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Paystack
PAYSTACK_SECRET_KEY=
